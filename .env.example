# ==============================================================================
# AI Customer Support Command Center — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual API keys and connection strings.
# ==============================================================================

# --- Application Settings ---
APP_NAME=AI Customer Support Agent Platform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (MySQL 8.0) ---
# When running via docker-compose, use mysql:3306/support_db
# When running locally on Windows outside Docker (with docker-compose mysql running), use localhost:3307/support_db
DATABASE_URL=mysql+pymysql://support_user:support_pass@localhost:3307/support_db

# --- Groq LLM API ---
# Get your free/dev API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Pinecone Vector Database ---
# Get your API key and environment from https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=support-kb-index
EMBEDDING_DIMENSION=384

# --- Embeddings Model ---
# Sentence-transformers model downloaded locally on first run
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- MLflow Tracking Server ---
# When running via docker-compose, use http://mlflow:5000
# When running locally, use http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ai-support-agent

# --- Retrieval & Quality Settings ---
MAX_RETRIEVAL_DOCS=5
SIMILARITY_THRESHOLD=0.65

# --- Frontend Settings ---
API_BASE_URL=http://localhost:8000
